{
  "name": "tish-creations-backend",
  "version": "2.1.0",
  "description": "Hardened all-in-one backend for the Tish Creations storefront — auth, products, Razorpay, Delhivery shipping, UPI QR payments, email + WhatsApp confirmations, and optional AI.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "hash-password": "node server.js hash-password",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=18 <22"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.1",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5"
  }
}
