# ============================================================================
#  TISH CREATIONS — environment variables
#  Copy the values you need into Railway → your service → "Variables" tab.
#  (Locally: copy this file to ".env" and fill it in.)
# ============================================================================

# ---- REQUIRED IN PRODUCTION ------------------------------------------------
NODE_ENV=production

# A long random string that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Your admin password, hashed. Generate it with:
#   node server.js hash-password
# then paste the ADMIN_PASSWORD_HASH=... line it prints here.
ADMIN_PASSWORD_HASH=

# PostgreSQL connection string.
# On Railway: add a Postgres database, then reference its variable so this
# stays in sync automatically → set the VALUE to:  ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# Managed Postgres (Railway/Render/Supabase/Neon) → keep this as "require".
# Only set to "disable" if you get a TLS/SSL connection error on boot.
DATABASE_SSL=require

# ---- RECOMMENDED -----------------------------------------------------------
# Your public site URL. Railway auto-detects its own domain, but setting this
# makes email links + absolute URLs correct. Example:
#   https://tish-creations-final-production.up.railway.app
STOREFRONT_URL=

# Extra browser origins allowed to call the API. Your Railway domain is trusted
# automatically; add a custom domain here later, comma-separated.
# ALLOWED_ORIGINS=https://tishcreations.com,https://www.tishcreations.com

# ---- OPTIONAL: payments (Razorpay) -----------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- OPTIONAL: UPI QR payments (no Razorpay needed) ------------------------
# UPI_ID=yourname@okhdfcbank
# UPI_PAYEE_NAME=Tish Creations

# ---- OPTIONAL: shipping (Delhivery) ----------------------------------------
DELHIVERY_TOKEN=
WAREHOUSE_PINCODE=250001

# ---- OPTIONAL: order-confirmation emails (Gmail SMTP) ----------------------
# Gmail app password (needs 2FA): https://myaccount.google.com/apppasswords
# SMTP_URL=smtps://yourgmail@gmail.com:your_app_password@smtp.gmail.com:465

# ---- OPTIONAL: WhatsApp Business Cloud API ---------------------------------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_FROM=919837229280
# OWNER_WHATSAPP=919837229280

# ---- OPTIONAL: "Sign in with Google" ---------------------------------------
# GOOGLE_CLIENT_ID=

# ---- OPTIONAL: AI features (search / recommendations / chatbot) ------------
# OPENAI_API_KEY=
